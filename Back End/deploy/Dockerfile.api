FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/api
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt && useradd --uid 10001 --create-home appuser
COPY api ./api
COPY migrations ./migrations
COPY alembic.ini ./
USER 10001:10001
EXPOSE 8002
# Run migrations separately, once per deployment. Never seed on server startup.
CMD ["uvicorn", "payment_module.main:app", "--app-dir", "api", "--host", "0.0.0.0", "--port", "8002", "--no-proxy-headers"]
