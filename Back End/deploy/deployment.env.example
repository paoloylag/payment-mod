# Copy to deploy/deployment.env; inject credentials at deployment, never commit them.
# Replace example host/bucket/database; this file alone does not authorize release.
APP_ENV=staging
APP_VERSION=replace-with-release-commit
DATABASE_URL=postgresql+psycopg://app_user:REPLACE@database.example.invalid:5432/payment_module?sslmode=verify-full&sslrootcert=/run/certs/rds-ca.pem
DATABASE_TIMEZONE=Asia/Manila
# Staging hostname is pending; production is planned as payment.life.edu.ph.
TRUSTED_HOSTS=staging-host.example.invalid
CORS_ORIGINS=https://staging-host.example.invalid
SESSION_COOKIE_SECURE=true
DEVELOPMENT_DEMO_PASSWORD=
S3_BUCKET=replace-with-private-bucket
S3_REGION=ap-southeast-1
S3_SERVER_SIDE_ENCRYPTION=AES256
SESSION_CLEANUP_ENABLED=false
DRAFT_ARCHIVAL_ENABLED=false
# No static AWS keys. Supply workload identity via the AWS container/instance role.
# Mount the approved database CA file read-only at /run/certs/rds-ca.pem.

# SMTP scaffold only. Existing notification worker remains database-only.
EMAIL_DELIVERY_ENABLED=false
EMAIL_TRANSPORT=disabled
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Payment Module
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=15
