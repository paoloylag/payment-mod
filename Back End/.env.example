APP_ENV=local
APP_NAME=Payment Module API
APP_VERSION=0.1.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO
PORT=8002
DATABASE_URL=postgresql+psycopg://payment_module:payment_module@127.0.0.1:5434/payment_module
DATABASE_TIMEZONE=Asia/Manila
CORS_ORIGINS=http://127.0.0.1:5175,http://localhost:5175,http://127.0.0.1:5176,http://localhost:5176
SESSION_SECRET=replace-with-a-long-random-string
SESSION_COOKIE_NAME=aps_session
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=8
SESSION_COOKIE_SECURE=false
# Development/test-only cleanup. The command hard-refuses staging and production.
SESSION_CLEANUP_ENABLED=false
SESSION_CLEANUP_RETENTION_DAYS=30
SESSION_CLEANUP_BATCH_SIZE=1000
# Set locally to enable the nine development persona accounts. Never commit the actual password.
DEVELOPMENT_DEMO_PASSWORD=
# Required only for company bank-account create/change/reveal operations. Generate with Fernet.generate_key().
BANK_ENCRYPTION_KEY=

LIFEOS_PUBLIC_URL=http://127.0.0.1:5174
LIFEOS_TENANT_ID=payment-module
LIFEOS_APP_ID=payment-module
LIFEOS_IDP_ENTITY_ID=http://127.0.0.1:5174/saml/idp/payment-module
LIFEOS_IDP_CERTIFICATE=

SAML_SP_ENTITY_ID=urn:lifeos:payment-module:sp
SAML_REQUIRE_SIGNED_RESPONSE=true
SAML_CLOCK_SKEW_SECONDS=120
