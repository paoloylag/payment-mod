APP_ENV=local
APP_NAME=Payment Module API
APP_VERSION=0.1.0
API_PREFIX=/api/v1
LOG_LEVEL=INFO
PORT=8002
DATABASE_URL=postgresql+psycopg://payment_module:payment_module@127.0.0.1:5434/payment_module
DATABASE_TIMEZONE=Asia/Manila
CORS_ORIGINS=http://127.0.0.1:5175,http://localhost:5175
SESSION_SECRET=replace-with-a-long-random-string

LIFEOS_PUBLIC_URL=http://127.0.0.1:5174
LIFEOS_TENANT_ID=payment-module
LIFEOS_APP_ID=payment-module
LIFEOS_IDP_ENTITY_ID=http://127.0.0.1:5174/saml/idp/payment-module
LIFEOS_IDP_CERTIFICATE=

SAML_SP_ENTITY_ID=urn:lifeos:payment-module:sp
SAML_REQUIRE_SIGNED_RESPONSE=true
SAML_CLOCK_SKEW_SECONDS=120
